MODULE main 
VAR


NS_light :
{
GREEN,
YELLOW,
RED
};


EW_light :
{
GREEN,
YELLOW,
RED
};



ASSIGN


init(NS_light) := GREEN;


init(EW_light) := RED;



-- =========================
-- NORTH SOUTH LIGHT
-- =========================


next(NS_light) :=

case


NS_light = GREEN :

YELLOW;


NS_light = YELLOW :

RED;


NS_light = RED :

GREEN;


TRUE :

NS_light;


esac;



-- =========================
-- EAST WEST LIGHT
-- =========================


next(EW_light) :=

case


EW_light = RED :

GREEN;


EW_light = GREEN :

YELLOW;


EW_light = YELLOW :

RED;


TRUE :

EW_light;


esac;



-- =========================
-- SAFETY PROPERTY
-- =========================


-- Không hai hướng cùng xanh


LTLSPEC

G !(

NS_light = GREEN

&

EW_light = GREEN

);



-- Không hai hướng cùng đỏ


LTLSPEC

G !(

NS_light = RED

&

EW_light = RED

);



-- =========================
-- LIVENESS
-- =========================


LTLSPEC

G(

NS_light = RED

->

F NS_light = GREEN

);



LTLSPEC

G(

EW_light = RED

->

F EW_light = GREEN

);