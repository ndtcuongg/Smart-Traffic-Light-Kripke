MODULE main 
VAR


state :
{
S0,
S1,
S2,
S3
};


NS_light :
{
GREEN,
YELLOW,
RED
};


EW_light :
{
GREEN,
YELLOW,
RED
};



ASSIGN


-- Trạng thái ban đầu

init(state) := S0;


init(NS_light) := GREEN;


init(EW_light) := RED;



-- ==========================
-- TRANSITION CÓ LỖI
-- ==========================


next(state) :=

case


-- LỖI:
-- Đúng ra:
-- S0 -> S1
--
-- Nhưng bị lập trình sai:
-- S0 -> S2


state = S0 :
S2;


state = S1 :
S2;


state = S2 :
S3;


state = S3 :
S0;


esac;



-- ==========================
-- CẬP NHẬT ĐÈN THEO STATE TIẾP THEO
-- ==========================


next(NS_light) :=

case


next(state)=S0 :
GREEN;


next(state)=S1 :
YELLOW;


next(state)=S2 :
RED;


next(state)=S3 :
RED;


esac;



next(EW_light) :=

case


next(state)=S0 :
RED;


next(state)=S1 :
RED;


next(state)=S2 :
GREEN;


next(state)=S3 :
YELLOW;


esac;



-- ==========================
-- PROPERTY 1:
-- Không được hai hướng cùng xanh
-- ==========================


LTLSPEC

G !(

NS_light = GREEN

&

EW_light = GREEN

);



-- ==========================
-- PROPERTY 2:
-- Nếu NS xanh thì bước tiếp phải vàng
-- ==========================


LTLSPEC

G(

state = S0

->

X(state = S1)

);