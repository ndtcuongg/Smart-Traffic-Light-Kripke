  },
  {
    "name": "synchronized_red",
    "formula": "AG((n_red = s_red) & (e_red = w_red))",
    "category": "safety"
  },
  {
    "name": "synchronized_yellow",
    "formula": "AG((n_yellow = s_yellow) & (e_yellow = w_yellow))",
