[
  {
    "name": "physical_green_exclusion",
    "formula": "AG(!conflicting_green)",
    "category": "safety"
  },
  {
    "name": "one_hot_n",
    "formula": "AG((n_red | n_yellow | n_green) & !(n_red & n_yellow) & !(n_red & n_green) & !(n_yellow & n_green))",
    "category": "safety"
  },
  {
    "name": "recurring_green_n",
    "formula": "AG(AF(n_green))",
    "category": "liveness"
  },
  {
    "name": "one_hot_s",
    "formula": "AG((s_red | s_yellow | s_green) & !(s_red & s_yellow) & !(s_red & s_green) & !(s_yellow & s_green))",
    "category": "safety"
  },
  {
    "name": "recurring_green_s",
    "formula": "AG(AF(s_green))",
    "category": "liveness"
  },
