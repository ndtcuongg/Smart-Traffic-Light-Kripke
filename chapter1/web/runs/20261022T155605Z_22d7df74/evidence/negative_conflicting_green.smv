  period_next := case (next_hour > 0 | (next_hour = 0 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) & !(next_hour > 6 | (next_hour = 6 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) : NIGHT_LOW; (next_hour > 6 | (next_hour = 6 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) & !(next_hour > 7 | (next_hour = 7 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) : NORMAL; (next_hour > 7 | (next_hour = 7 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) & !(next_hour > 9 | (next_hour = 9 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) : MORNING_PEAK; (next_hour > 9 | (next_hour = 9 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) & !(next_hour > 16 | (next_hour = 16 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) : NORMAL; (next_hour > 16 | (next_hour = 16 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) & !(next_hour > 19 | (next_hour = 19 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) : EVENING_PEAK; (next_hour > 19 | (next_hour = 19 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) & !(next_hour > 22 | (next_hour = 22 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) : NORMAL; (next_hour > 22 | (next_hour = 22 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) & !(next_hour > 24 | (next_hour = 24 & (next_minute > 0 | (next_minute = 0 & next_second >= 0)))) : NIGHT_LOW; TRUE : NIGHT_LOW; esac;
  phase_after := case phase = NS_GREEN : NS_YELLOW; phase = NS_YELLOW : ALL_RED_NS_TO_EW; phase = ALL_RED_NS_TO_EW : EW_GREEN; phase = EW_GREEN : EW_YELLOW; phase = EW_YELLOW : ALL_RED_EW_TO_NS; phase = ALL_RED_EW_TO_NS : NS_GREEN; TRUE : NS_GREEN; esac;
