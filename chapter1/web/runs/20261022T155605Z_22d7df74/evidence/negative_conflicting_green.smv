  next_phase_duration := case phase_after = NS_GREEN & period_next = MORNING_PEAK : 45; phase_after = NS_YELLOW & period_next = MORNING_PEAK : 3; phase_after = ALL_RED_NS_TO_EW & period_next = MORNING_PEAK : 2; phase_after = EW_GREEN & period_next = MORNING_PEAK : 35; phase_after = EW_YELLOW & period_next = MORNING_PEAK : 3; phase_after = ALL_RED_EW_TO_NS & period_next = MORNING_PEAK : 2; phase_after = NS_GREEN & period_next = NORMAL : 25; phase_after = NS_YELLOW & period_next = NORMAL : 3; phase_after = ALL_RED_NS_TO_EW & period_next = NORMAL : 2; phase_after = EW_GREEN & period_next = NORMAL : 25; phase_after = EW_YELLOW & period_next = NORMAL : 3; phase_after = ALL_RED_EW_TO_NS & period_next = NORMAL : 2; phase_after = NS_GREEN & period_next = EVENING_PEAK : 35; phase_after = NS_YELLOW & period_next = EVENING_PEAK : 3; phase_after = ALL_RED_NS_TO_EW & period_next = EVENING_PEAK : 2; phase_after = EW_GREEN & period_next = EVENING_PEAK : 45; phase_after = EW_YELLOW & period_next = EVENING_PEAK : 3; phase_after = ALL_RED_EW_TO_NS & period_next = EVENING_PEAK : 2; phase_after = NS_GREEN & period_next = NIGHT_LOW : 15; phase_after = NS_YELLOW & period_next = NIGHT_LOW : 3; phase_after = ALL_RED_NS_TO_EW & period_next = NIGHT_LOW : 2; phase_after = EW_GREEN & period_next = NIGHT_LOW : 15; phase_after = EW_YELLOW & period_next = NIGHT_LOW : 3; phase_after = ALL_RED_EW_TO_NS & period_next = NIGHT_LOW : 2; TRUE : 1; esac;
  initial_duration := case ALL_RED_EW_TO_NS = NS_GREEN & period = MORNING_PEAK : 45; ALL_RED_EW_TO_NS = NS_YELLOW & period = MORNING_PEAK : 3; ALL_RED_EW_TO_NS = ALL_RED_NS_TO_EW & period = MORNING_PEAK : 2; ALL_RED_EW_TO_NS = EW_GREEN & period = MORNING_PEAK : 35; ALL_RED_EW_TO_NS = EW_YELLOW & period = MORNING_PEAK : 3; ALL_RED_EW_TO_NS = ALL_RED_EW_TO_NS & period = MORNING_PEAK : 2; ALL_RED_EW_TO_NS = NS_GREEN & period = NORMAL : 25; ALL_RED_EW_TO_NS = NS_YELLOW & period = NORMAL : 3; ALL_RED_EW_TO_NS = ALL_RED_NS_TO_EW & period = NORMAL : 2; ALL_RED_EW_TO_NS = EW_GREEN & period = NORMAL : 25; ALL_RED_EW_TO_NS = EW_YELLOW & period = NORMAL : 3; ALL_RED_EW_TO_NS = ALL_RED_EW_TO_NS & period = NORMAL : 2; ALL_RED_EW_TO_NS = NS_GREEN & period = EVENING_PEAK : 35; ALL_RED_EW_TO_NS = NS_YELLOW & period = EVENING_PEAK : 3; ALL_RED_EW_TO_NS = ALL_RED_NS_TO_EW & period = EVENING_PEAK : 2; ALL_RED_EW_TO_NS = EW_GREEN & period = EVENING_PEAK : 45; ALL_RED_EW_TO_NS = EW_YELLOW & period = EVENING_PEAK : 3; ALL_RED_EW_TO_NS = ALL_RED_EW_TO_NS & period = EVENING_PEAK : 2; ALL_RED_EW_TO_NS = NS_GREEN & period = NIGHT_LOW : 15; ALL_RED_EW_TO_NS = NS_YELLOW & period = NIGHT_LOW : 3; ALL_RED_EW_TO_NS = ALL_RED_NS_TO_EW & period = NIGHT_LOW : 2; ALL_RED_EW_TO_NS = EW_GREEN & period = NIGHT_LOW : 15; ALL_RED_EW_TO_NS = EW_YELLOW & period = NIGHT_LOW : 3; ALL_RED_EW_TO_NS = ALL_RED_EW_TO_NS & period = NIGHT_LOW : 2; TRUE : 1; esac;
